<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />

  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FlushedYo.Core\FlushedYo.Core.csproj" />
    <ProjectReference Include="..\..\src\FlushedYo.Cli\FlushedYo.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FlushedYo.Tests.FakeMcpServer\FlushedYo.Tests.FakeMcpServer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FlushedYo.Tests.StubPlugin\FlushedYo.Tests.StubPlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyHelpers" AfterTargets="Build">
    <ItemGroup>
      <FakeServerFiles Include="..\FlushedYo.Tests.FakeMcpServer\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
      <CliFiles Include="..\..\src\FlushedYo.Cli\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
      <StubPluginFiles Include="..\FlushedYo.Tests.StubPlugin\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeServerFiles)" 
          DestinationFolder="$(OutDir)helpers\fake-mcp-server\%(RecursiveDir)" 
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CliFiles)" 
          DestinationFolder="$(OutDir)helpers\cli\%(RecursiveDir)" 
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StubPluginFiles)"
          DestinationFolder="$(OutDir)helpers\stub-plugin\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
