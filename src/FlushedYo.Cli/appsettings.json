{
  "FlushedYo": {
    "SecretStore": {
      "Provider": "BitwardenMcp",
      "BitwardenMcp": {
        "Command": "npx",
        "Arguments": [ "-y", "@bitwarden/mcp-server" ],
        "GetSecretTool": "get",
        "SecretKeyArgument": "id",
        "ToolArguments": { "object": "password" },
        "EnvironmentVariables": { "BW_SESSION": "${BW_SESSION}" },
        "ConnectTimeoutSeconds": 30,
        "CallTimeoutSeconds": 30
      }
    },
    "PluginDirectory": "plugins",
    "LedgerPath": "data/flushedyo.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "System": "Warning",
      "Microsoft": "Warning"
    }
  }
}
